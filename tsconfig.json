{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./04-nextjs-shadcn/*"]
    }
  },
  "include": [
    "01-html-css-js/**/*",
    "02-react-tailwind/src/**/*",
    "03-nextjs-tailwind/app/**/*",
    "04-nextjs-shadcn/**/*"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/.next"]
}
